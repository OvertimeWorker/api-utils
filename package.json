{
  "name": "overtime-worker-api-utils",
  "version": "1.0.7",
  "license": "GPL-3.0",
  "author": "wjnotl",
  "type": "module",
  "exports": {
    "./*": {
      "types": "./dist/*/index.d.ts",
      "import": "./dist/*/index.js"
    }
  },
  "bin": {
    "gen-metadata": "scripts/generate-metadata.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "scripts"
  ],
  "scripts": {
    "prebuild": "pnpm generate",
    "build": "tsc && tsc-alias",
    "generate": "node scripts/generate-indices.js",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint . --ext .ts,.js --fix",
    "prepare": "pnpm build"
  },
  "dependencies": {
    "@prisma/generator-helper": "7.5.0",
    "axios": "1.15.0",
    "cli-table3": "0.6.5",
    "http-status-codes": "2.3.0",
    "jsonwebtoken": "9.0.3",
    "pg-boss": "12.16.0",
    "picocolors": "1.1.1",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@prisma/client": "7.5.0",
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/pluralize": "0.0.33",
    "eslint": "10.2.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import-x": "4.16.2",
    "eslint-plugin-prettier": "5.5.5",
    "pluralize": "8.0.0",
    "tsc-alias": "1.8.16",
    "typescript": "6.0.3",
    "typescript-eslint": "8.58.1"
  }
}
